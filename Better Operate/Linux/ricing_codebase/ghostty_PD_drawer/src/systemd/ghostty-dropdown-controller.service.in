[Unit]
Description=Control the Ghostty PD drawer
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment=GHOSTTY_PD_DRAWER_GHOSTTY=@GHOSTTY_BIN@
Environment=GHOSTTY_PD_DRAWER_RUNTIME_DIR=@RUNTIME_DIR@/ghostty-pd-drawer
Environment=GHOSTTY_PD_DRAWER_CONFIG=@CONFIG_HOME@/ghostty/dropdown.ghostty
Environment=GHOSTTY_PD_DRAWER_DEFAULT_CONFIG=@CONFIG_HOME@/ghostty/config
Environment=GHOSTTY_PD_DRAWER_DEFAULT_CONFIG_GHOSTTY=@CONFIG_HOME@/ghostty/config.ghostty
ExecStart=@PYTHON_BIN@ @CONTROLLER_PATH@
Restart=on-failure

[Install]
WantedBy=graphical-session.target

[Unit]
Description=Send a scheduled hello to Codex CLI (Luna, low reasoning)
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=CODEX_HOME=%h/.local/share/codex-hello
WorkingDirectory=%h
ExecStart=/usr/bin/env codex exec --ephemeral --skip-git-repo-check --sandbox read-only --color never --model gpt-5.6-luna --config model_reasoning_effort=low hello
TimeoutStartSec=10min
